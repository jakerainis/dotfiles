# This is the configuration file for Ghostty.

# Run `ghostty +show-config --default --docs` to view a list of all available config options and their default values.

# Additionally, each config option is also explained in detail on Ghostty's website, at https://ghostty.org/docs/config.

## Terminal settings

adjust-cell-height= 4
background-blur = true
background-opacity = 0.85
font-family = "JetBrainsMono Nerd Font"
font-size = 16
font-thicken = true
macos-titlebar-style = transparent
quick-terminal-animation-duration = 0.1
quick-terminal-position=center
quick-terminal-size = 90%
window-padding-x = 10
window-padding-y = 10

## Keybindings

keybind = global:shift+escape=toggle_visibility
keybind = cmd+shift+|=new_split:right
keybind = cmd+shift+_=new_split:down
keybind = global:alt+tab=toggle_quick_terminal
keybind = global:super+d=unbind

# Theme (other nice themes: Desert, Kanagawa Wave, rose-pine)
# theme = "catppuccin-mocha.conf"
theme = "Everforest Dark Hard"
# theme = "Kanagawa Dragon"

# Shaders
custom-shader = shaders/synesthaxia.glsl
